# BErozgar - Server Environment Variables
# Copy to .env and fill in real values

# -- Server ------------------------------------------------------------------
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# -- Database ----------------------------------------------------------------
# Local development (run: docker compose up postgres  OR  use your own Postgres)
DATABASE_URL=postgresql://berozgar:berozgar123@127.0.0.1:5433/berozgar?schema=public
# Neon cloud -- fill in real credentials from Neon dashboard, never commit them:
# DATABASE_URL=postgresql://neondb_owner:<password>@<host>.neon.tech/neondb?sslmode=require&channel_binding=disable

# -- JWT ---------------------------------------------------------------------
# IMPORTANT: Generate a real secret for production (min 32 chars)
JWT_SECRET=dev-secret-change-me-in-production-minimum-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# -- Google OAuth ------------------------------------------------------------
# Leave empty to disable Google Sign-In (graceful degradation)
# Set to your real client ID from console.cloud.google.com when ready
GOOGLE_CLIENT_ID=

# -- CORS --------------------------------------------------------------------
CORS_ORIGIN=http://localhost:8080,http://localhost:8081

# -- Email -------------------------------------------------------------------
EMAIL_PROVIDER=log
EMAIL_FROM=BErozgar <noreply@berozgar.local>

# -- Sentry (optional in dev) ------------------------------------------------
# SENTRY_DSN=https://xxx@sentry.io/xxx

# -- Rate Limiting -----------------------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# -- Dev Testing Overrides ---------------------------------------------------
# CRITICAL: Allow auth cookies to be set over HTTP in local dev
# Default is true (HTTPS only) which breaks ALL auth in plain HTTP dev server
COOKIE_SECURE=false
# Disable CSRF enforcement locally (the frontend still sends CSRF tokens,
# but this removes the strict validation so dev testing is friction-free)
CSRF_ENFORCE=false
# Leave empty to allow signups from ANY email domain during testing
# Remove this line (or set to mctrgit.ac.in) to restore the domain restriction
ALLOWED_EMAIL_DOMAINS=
# Extra admin emails for dev testing -- create an account with this email to
# get admin panel access (admin@mctrgit.ac.in always works too)
ADMIN_EMAILS=kartikhulmukh24@gmail.com
