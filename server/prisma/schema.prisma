generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String          @id @default(uuid())
  googleId            String?         @unique @map("google_id")
  email               String          @unique
  fullName            String          @map("full_name")
  password            String?
  role                UserRole        @default(PUBLIC_USER)
  trustStatus         String          @default("GOOD_STANDING") @map("trust_status")
  verified            Boolean         @default(false)
  completedExchanges  Int             @default(0) @map("completed_exchanges")
  cancelledRequests   Int             @default(0) @map("cancelled_requests")
  adminFlags          Int             @default(0) @map("admin_flags")
  failedLoginAttempts Int             @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?       @map("locked_until")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  avatarUrl           String?         @map("avatar_url")
  isRestricted        Boolean         @default(false) @map("is_restricted")
  privilegeLevel      PrivilegeLevel  @default(STANDARD) @map("privilege_level")
  restrictionReason   String?         @map("restriction_reason")
  collegeStudentId    String?         @unique @map("college_student_id")
  auditLogs           AuditLog[]      @relation("AuditActor")
  disputesAgainst     Dispute[]       @relation("AgainstDisputes")
  disputes            Dispute[]       @relation("RaisedDisputes")
  listings            Listing[]
  otps                Otp[]
  refreshTokens       RefreshToken[]
  buyerRequests       Request[]       @relation("BuyerRequests")
  sellerRequests      Request[]       @relation("SellerRequests")
  collegeStudent      CollegeStudent? @relation(fields: [collegeStudentId], references: [id])

  @@index([email])
  @@index([role])
  @@map("users")
}

model CollegeStudent {
  id            String   @id @default(uuid())
  name          String
  officialEmail String   @unique @map("official_email")
  phone         String?
  department    String?
  year          String?
  createdAt     DateTime @default(now()) @map("created_at")
  user          User?

  @@index([officialEmail])
  @@map("college_students")
}

model RefreshToken {
  id              String    @id @default(uuid())
  token           String    @unique
  userId          String    @map("user_id")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  replacedByToken String?   @map("replaced_by_token")
  userAgent       String?   @map("user_agent")
  ipAddress       String?   @map("ip_address")
  createdAt       DateTime  @default(now()) @map("created_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model Otp {
  id        String    @id @default(uuid())
  email     String
  code      String
  userId    String?   @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  attempts  Int       @default(0)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, code])
  @@map("otps")
}

model Listing {
  id          String        @id @default(uuid())
  ownerId     String        @map("owner_id")
  title       String
  price       Decimal       @default(0)
  status      ListingStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  category    String?
  description String?
  module      String?
  disputes    Dispute[]     @relation("DisputeListing")
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  requests    Request[]

  @@index([ownerId])
  @@index([status])
  @@index([category])
  @@index([createdAt(sort: Desc)])
  @@map("listings")
}

model Request {
  id        String        @id @default(uuid())
  listingId String        @map("listing_id")
  buyerId   String        @map("buyer_id")
  status    RequestStatus @default(IDLE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  sellerId  String        @map("seller_id")
  version   Int           @default(0)
  disputes  Dispute[]
  buyer     User          @relation("BuyerRequests", fields: [buyerId], references: [id])
  listing   Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller    User          @relation("SellerRequests", fields: [sellerId], references: [id])

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("requests")
}

model Dispute {
  id          String        @id @default(uuid())
  requestId   String?       @map("request_id")
  raisedById  String        @map("raised_by")
  status      DisputeStatus @default(OPEN)
  createdAt   DateTime      @default(now()) @map("created_at")
  againstId   String        @map("against_id")
  description String
  listingId   String?       @map("listing_id")
  type        DisputeType
  against     User          @relation("AgainstDisputes", fields: [againstId], references: [id])
  listing     Listing?      @relation("DisputeListing", fields: [listingId], references: [id])
  raisedBy    User          @relation("RaisedDisputes", fields: [raisedById], references: [id])
  request     Request?      @relation(fields: [requestId], references: [id])

  @@index([raisedById])
  @@index([againstId])
  @@index([status])
  @@map("disputes")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  actorRole  String?  @map("actor_role")
  ipAddress  String?  @map("ip_address")
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model IdempotencyKey {
  id             String   @id @default(uuid())
  key            String   @unique
  userId         String   @map("user_id")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([key, userId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

enum UserRole {
  STUDENT_VERIFIED
  PUBLIC_USER
  ADMIN
}

enum PrivilegeLevel {
  STANDARD
  SUPER
  OBSERVER
  REVIEWER
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  INTEREST_RECEIVED
  IN_TRANSACTION
  COMPLETED
  EXPIRED
  FLAGGED
  ARCHIVED
  REMOVED
}

enum RequestStatus {
  IDLE
  SENT
  ACCEPTED
  DECLINED
  MEETING_SCHEDULED
  COMPLETED
  EXPIRED
  CANCELLED
  WITHDRAWN
  DISPUTED
  RESOLVED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
  ESCALATED
}

enum DisputeType {
  FRAUD
  ITEM_NOT_AS_DESCRIBED
  NO_SHOW
  OTHER
}
