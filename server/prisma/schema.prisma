generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String          @id @default(uuid()) @db.Uuid
  googleId            String?         @unique @map("google_id")
  email               String          @unique
  fullName            String          @map("full_name")
  password            String?
  role                UserRole        @default(PUBLIC_USER)
  trustStatus         String          @default("GOOD_STANDING") @map("trust_status")
  verified            Boolean         @default(false)
  completedExchanges  Int             @default(0) @map("completed_exchanges")
  cancelledRequests   Int             @default(0) @map("cancelled_requests")
  adminFlags          Int             @default(0) @map("admin_flags")
  failedLoginAttempts Int             @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?       @map("locked_until")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  avatarUrl           String?         @map("avatar_url")
  isRestricted        Boolean         @default(false) @map("is_restricted")
  privilegeLevel      PrivilegeLevel  @default(STANDARD) @map("privilege_level")
  restrictionReason   String?         @map("restriction_reason")
  collegeStudentId    String?         @unique @map("college_student_id")
  auditLogs           AuditLog[]      @relation("AuditActor")
  disputesAgainst     Dispute[]       @relation("AgainstDisputes")
  disputes            Dispute[]       @relation("RaisedDisputes")
  listings            Listing[]
  otps                Otp[]
  refreshTokens       RefreshToken[]
  buyerRequests       Request[]       @relation("BuyerRequests")
  sellerRequests      Request[]       @relation("SellerRequests")
  messages            Message[]
  analyticsEvents     AnalyticsEvent[]
  collegeStudent      CollegeStudent? @relation(fields: [collegeStudentId], references: [id])

  @@index([email])
  @@index([role])
  @@map("users")
}

model CollegeStudent {
  id            String   @id @default(uuid())
  name          String
  officialEmail String   @unique @map("official_email")
  phone         String?
  department    String?
  year          String?
  createdAt     DateTime @default(now()) @map("created_at")
  user          User?

  @@index([officialEmail])
  @@map("college_students")
}

model RefreshToken {
  id              String    @id @default(uuid()) @db.Uuid
  token           String    @unique
  userId          String    @map("user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  replacedByToken String?   @map("replaced_by_token")
  userAgent       String?   @map("user_agent")
  ipAddress       String?   @map("ip_address")
  createdAt       DateTime  @default(now()) @map("created_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model Otp {
  id        String    @id @default(uuid()) @db.Uuid
  email     String
  code      String
  userId    String?   @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  attempts  Int       @default(0)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, code])
  @@map("otps")
}

model Listing {
  id          String        @id @default(uuid()) @db.Uuid
  ownerId     String        @map("owner_id") @db.Uuid
  title       String
  price       Decimal       @default(0)
  status      ListingStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  category    String?
  description String?
  module      ListingModule?
  disputes    Dispute[]     @relation("DisputeListing")
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  requests    Request[]
  images      ListingImage[]

  @@index([ownerId])
  @@index([status])
  @@index([category])
  @@index([createdAt(sort: Desc)])
  @@index([module])
  @@map("listings")
}

model Request {
  id        String        @id @default(uuid()) @db.Uuid
  listingId String        @map("listing_id") @db.Uuid
  buyerId   String        @map("buyer_id") @db.Uuid
  status    RequestStatus @default(IDLE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  sellerId  String        @map("seller_id") @db.Uuid
  version   Int           @default(0)
  disputes  Dispute[]
  messages  Message[]
  buyer     User          @relation("BuyerRequests", fields: [buyerId], references: [id])
  listing   Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller    User          @relation("SellerRequests", fields: [sellerId], references: [id])

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("requests")
}

model Dispute {
  id          String        @id @default(uuid()) @db.Uuid
  requestId   String?       @map("request_id") @db.Uuid
  raisedById  String        @map("raised_by") @db.Uuid
  status      DisputeStatus @default(OPEN)
  createdAt   DateTime      @default(now()) @map("created_at")
  againstId   String        @map("against_id") @db.Uuid
  description String
  listingId   String?       @map("listing_id") @db.Uuid
  type        DisputeType
  against     User          @relation("AgainstDisputes", fields: [againstId], references: [id])
  listing     Listing?      @relation("DisputeListing", fields: [listingId], references: [id])
  raisedBy    User          @relation("RaisedDisputes", fields: [raisedById], references: [id])
  request     Request?      @relation(fields: [requestId], references: [id])

  @@index([raisedById])
  @@index([againstId])
  @@index([status])
  @@map("disputes")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  actorRole  String?  @map("actor_role")
  ipAddress  String?  @map("ip_address")
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @unique
  userId         String   @map("user_id") @db.Uuid
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([key, userId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

enum UserRole {
  STUDENT_VERIFIED
  PUBLIC_USER
  ADMIN
}

enum PrivilegeLevel {
  STANDARD
  SUPER
  OBSERVER
  REVIEWER
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  INTEREST_RECEIVED
  IN_TRANSACTION
  COMPLETED
  EXPIRED
  FLAGGED
  ARCHIVED
  REMOVED
}

enum RequestStatus {
  IDLE
  SENT
  ACCEPTED
  DECLINED
  MEETING_SCHEDULED
  COMPLETED
  EXPIRED
  CANCELLED
  WITHDRAWN
  DISPUTED
  RESOLVED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
  ESCALATED
}

enum DisputeType {
  FRAUD
  ITEM_NOT_AS_DESCRIBED
  NO_SHOW
  OTHER
}

enum ListingModule {
  ACCOMMODATION
  RESALE
  ACADEMICS
  MESS
  HOSPITAL
}

model ListingImage {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_images")
}

model MessProvider {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  type         String   // "canteen" | "tiffin" | "cloud_kitchen"
  location     String?
  timings      String?
  priceRange   String?  @map("price_range")
  cuisine      String[]
  contactPhone String?  @map("contact_phone")
  rating       Float?   @default(0)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("mess_providers")
}

model Hospital {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  type           String   // "campus" | "hospital" | "clinic" | "dispensary"
  address        String
  distance       String?
  specialties    String[]
  contactPhone   String?  @map("contact_phone")
  emergencyPhone String?  @map("emergency_phone")
  rating         Float?   @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("hospitals")
}

// Only metadata is retained: never raw client properties, queries or contact details.
model AnalyticsEvent {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(64)
  level      String   @db.VarChar(10)
  occurredAt DateTime @map("occurred_at")
  receivedAt DateTime @default(now()) @map("received_at")
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([receivedAt])
  @@index([name, receivedAt])
  @@map("analytics_events")
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  clientId  String   @map("client_id") @db.VarChar(36)
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at")
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([requestId, senderId, clientId])
  @@index([requestId, createdAt, id])
  @@map("messages")
}

model CampusQaGap {
  id         String   @id @default(uuid()) @db.Uuid
  queryHash  String   @unique @map("query_hash") @db.VarChar(64)
  queryText  String   @map("query_text") @db.VarChar(200)
  hits       Int      @default(1)
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  /// Set when an admin publishes a reviewed answer for this gap; cleared if the gap is asked again unmatched.
  resolvedAt DateTime? @map("resolved_at")
  answerId   String?   @map("answer_id") @db.Uuid

  @@index([hits])
  @@index([resolvedAt])
  @@map("campus_qa_gaps")
}

/// Admin-reviewed campus answers stored in the database (APODEX continuation k).
/// Merged with the static in-repo corpus by the deterministic Q&A engine.
model CampusQaAnswer {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(80)
  question    String   @db.VarChar(200)
  answer      String   @db.VarChar(1200)
  topic       String   @db.VarChar(20)
  keywords    String[]
  source      String   @db.VarChar(300)
  published   Boolean  @default(true)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([published])
  @@map("campus_qa_answers")
}

/// Aggregate-only observed Q&A traffic; no query text or visitor identifiers.
model CampusQaDailyMetric {
  day        DateTime @id @db.Date
  answered   Int @default(0)
  unanswered Int @default(0)
  reopened   Int @default(0)

  @@map("campus_qa_daily_metrics")
}
